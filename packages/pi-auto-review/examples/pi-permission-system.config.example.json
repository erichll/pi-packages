{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",

  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "piInfrastructureReadPaths": [
    "~/.cargo/registry/*",
    "~/.npm/*"
  ],
  "authorizerChain": [
    "pi-auto-review"
  ],
  "permission": {
    "*": "ask",
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/.agents/skills/*": "allow"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      ".envrc": "deny",
      ".npmrc": "deny",
      ".pypirc": "deny",
      ".netrc": "deny",
      ".git-credentials": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny",
      ".git/config": "deny",
      ".git/hooks/*": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.kube/*": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.azure/*": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/cliproxyapi.json": "deny"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": {
      "*": "allow",
      "*.lock": "deny"
    },
    "edit": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git -C *": "ask",
      "git -c *": "ask",
      "git --git-dir*": "ask",
      "git --work-tree*": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git checkout *": "ask",
      "git restore *": "ask",
      "git rebase *": "ask",
      "git branch -D *": "ask",
      "git branch --delete *": "ask",
      "git config *": "ask",
      "git remote add *": "ask",
      "git remote set-url *": "ask",
      "git remote remove *": "ask",
      "git push *": "ask",
      "git send-pack *": "ask",
      "rtk ls *": "allow",
      "rtk read *": "allow",
      "rtk smart *": "allow",
      "rtk find *": "allow",
      "rtk grep *": "allow",
      "rtk rg *": "allow",
      "rtk diff *": "allow",
      "rtk wc *": "allow",
      "rtk git status *": "allow",
      "rtk git diff *": "allow",
      "rtk git log *": "allow",
      "rtk git add *": "allow",
      "rtk git commit *": "allow",
      "rtk git show *": "allow",
      "rtk git branch": "allow",
      "rtk git branch --show-current *": "allow",
      "rtk git branch -v *": "allow",
      "rtk git branch -a *": "allow",
      "tmux capture-pane *": "allow",
      "tmux display-message *": "allow",
      "tmux display-menu *": "allow",
      "tmux display-panes *": "allow",
      "tmux display-popup *": "allow",
      "tmux find-window *": "allow",
      "tmux has-session *": "allow",
      "tmux list-*": "allow",
      "tmux show-*": "allow",
      "tmux last-pane *": "allow",
      "tmux last-window *": "allow",
      "tmux next-window *": "allow",
      "tmux previous-window *": "allow",
      "tmux select-layout *": "allow",
      "tmux select-pane *": "allow",
      "tmux select-window *": "allow",
      "tmux switch-client *": "allow",
      "tmux wait-for *": "allow",
      "cd ~/.agents/skills*": "allow",
      "bash ~/.agents/skills/*": "allow",
      "sh ~/.agents/skills/*": "allow",
      "cat ~/.agents/skills/*": "allow",
      "cd *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "command -v *": "allow",
      "mkdir *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "sleep *": "allow",
      "export *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "jq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "uniq *": "allow",
      "nl *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "diff *": "allow",
      "pwd": "allow",
      "date *": "allow",
      "which *": "allow",
      "type *": "allow"
    },
    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "ask_user": "allow",
    "todo": "allow",
    "web_search": "allow",
    "get_search_content": "allow",
    "fetch_content": "ask"
  }
}
